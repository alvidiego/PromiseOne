Set-StrictMode -Version Latest
$PSDefaultParameterValues['Out-File:Encoding'] = 'utf8'
. "$PSScriptRoot\..\utils\config.ps1"
. "$PSScriptRoot\..\utils\utils.ps1"

function Write-MemorySnapshot {
  param(
    [Parameter(Mandatory)] [object]$Data,
    [string]$Source = "",
    [hashtable]$Meta = @{},
    [switch]$Verbose
  )
  Ensure-Directory -Path $MemoryRoot -Verbose:$Verbose
  $stamp = Get-Date -Format "yyyyMMdd_HHmmss"
  $obj = [ordered]@{ source=$Source; meta=$Meta; data=$Data; ts=(Get-Date).ToString("o") }
  $file = Join-Path $MemoryRoot ("snapshot_{0}.json" -f $stamp)
  $obj | ConvertTo-Json -Depth 10 | Out-File -FilePath $file
  Log "[MEMORY] Snapshot → $file" -Level "Info" -Verbose:$Verbose
  $file
}
