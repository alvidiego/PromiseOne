[CmdletBinding()] param(
  [Parameter(Mandatory)][string]$Input,
  [string]$Client = "default",
  [ValidateSet("Folder","Vercel","GitHub")] [string]$Provider = "Folder",
  [switch]$DryRun
)
Set-StrictMode -Version Latest
$VerboseOn = $PSBoundParameters.ContainsKey('Verbose')
. "$PSScriptRoot\..\utils\config.ps1"
. "$PSScriptRoot\..\utils\utils.ps1"

$dirs = @($TemplatesRoot,$MemoryRoot,$SystemLogsRoot,$TriggerLogsRoot,$SiteOutputRoot,$DeploymentsPath)
foreach ($d in $dirs) { Ensure-Directory -Path $d -Verbose:$VerboseOn }

try {
  $adv    = & "$PSScriptRoot\advisor.ps1" -Input $Input -Client $Client -Verbose:$VerboseOn -DryRun:$DryRun
  if (-not $adv -or -not $adv.Path) { throw "advisor failed" }

  $plan   = & "$PSScriptRoot\plan.ps1" -TriggerFile $adv.Path -Verbose:$VerboseOn -DryRun:$DryRun
  if (-not $plan) { throw "plan failed" }

  $build  = & "$PSScriptRoot\build.ps1" -PlanFile (Join-Path $MemoryRoot "latest_plan.json") -Verbose:$VerboseOn -DryRun:$DryRun
  if (-not $build -or -not $build.Output) { throw "build failed" }

  $deploy = & "$PSScriptRoot\deploy.ps1" -BuildPath $build.Output -Provider $Provider -Client $Client -Verbose:$VerboseOn -DryRun:$DryRun
  $final  = if ($DryRun) { "DryRun" } elseif ($deploy.status -eq "Deployed") { "Success" } else { "Partial" }

  [pscustomobject]@{ status=$final; url=$deploy.url }
}
catch {
  Log "[ENGINE] Error → $($_.Exception.Message)" -Level "Error" -Verbose:$VerboseOn
  [pscustomobject]@{ status="Failed"; url="" }
}




